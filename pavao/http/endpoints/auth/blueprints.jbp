
type password: string (minLength=8, maxLength=128) 

node credentials {
	login: string (minLength=2, maxLength=128),
	password: password
}

node tokenInfo {
	token: string,
	change_password: bool,
	expires: integer
}

node passwordUpdate {
	oldPassword: password,
	newPassword: password
}

node userInfo {
	firstName: string,
	optional lastName: string,
	administrator: bool
}

